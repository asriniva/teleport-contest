{
  "name": "teleport-contest",
  "version": "1.0.0",
  "description": "The Teleport Coding Challenge — Port NetHack C to JavaScript",
  "type": "module",
  "scripts": {
    "score": "bash scripts/score-js.sh",
    "play": "echo 'Open index.html in a browser to play'",
    "setup:wasm": "bash nethack-c/setup-wasm.sh",
    "build:wasm": "bash nethack-c/build-wasm.sh",
    "test:wasm": "bash scripts/test-wasm.sh",
    "test:native": "bash scripts/test-native-tu.sh",
    "test:dependencies": "bash scripts/test-js-dependencies.sh",
    "test": "bash scripts/test-pure-js-tu.sh",
    "test:pure-js": "bash scripts/test-pure-js-tu.sh",
    "test:layout": "node scripts/test-nethack-layout.mjs"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "acorn": "8.14.1"
  }
}
